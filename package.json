{
  "name": "verse",
  "version": "1.0.0",
  "description": "Display a random bible verse upon page refresh.",
  "author": "Bill",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "list": "node scripts/dev.js list",
    "generate": "node scripts/dev.js generate",
    "parse-prd": "node scripts/dev.js parse-prd",
    "start": "node src/index.js",
    "clean": "rm -f public/verses.json && rm -rf public/images",
    "build": "npm run build:js && npm run build:css && npm run optimize:images",
    "build:js": "esbuild public/app.js --bundle --minify --outfile=public/app.min.js --format=esm",
    "build:css": "postcss public/styles.css -o public/styles.min.css",
    "optimize:images": "node scripts/optimize-images.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "setup": "node src/download-images.js && npm run optimize:images",
    "prepare": "npm run setup",
    "static": "node scripts/generate-static.js",
    "serve:static": "npx serve dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "boxen": "^7.1.1",
    "canvas": "^3.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "openai": "^4.86.1",
    "ora": "^7.0.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.2",
    "fastmcp": "^1.20.5",
    "fuse.js": "^7.0.0",
    "helmet": "^8.1.0",
    "inquirer": "^12.5.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.6",
    "esbuild": "^0.20.2",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1"
  }
}